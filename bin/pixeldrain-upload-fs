#!/bin/zsh
# Upload files/folders into a chosen directory of the PixelDrain Filesystem
# (pixeldrain.com/d/me, a Pro feature). A native picker window (pixeldrain-picker,
# an NSBrowser column view) handles Finder-style navigation: open a folder and a
# new column slides in, "New Folder…" and "Copy/Move" appear as in-window sheets.
# This script is the controller — it lists directories for the picker over a
# coprocess and does the actual uploading; the picker is a pure view.
#
# Folders are uploaded file-by-file, recreating the folder tree on PixelDrain
# (make_parents), so the progress window can show each file as it goes up and
# per-file skip/move can work. After picking a destination you choose Copy or
# Move; Move permanently deletes each local file once it uploads — it does not
# move them to the Trash, so there is no undo. In both modes a file that already
# exists in the destination with the same name and size is skipped (in Move it is
# left on disk).
#
# Shows a floating progress window with live status, per-file names, overall
# byte-weighted percentage, a Pause/Resume button, and a Cancel button.
# API key is read from ~/.pixeldrain_api_key and passed to the helpers via the
# PD_AUTH_KEY environment variable, set per-invocation on just the commands that
# need it (never on a command line, so it can't leak through `ps`, and never in
# the environment of unrelated children like osascript or find).
#
# Every file's outcome is appended to ~/Library/Logs/pixeldrain-upload.log; the
# progress window can only show a summary, so the log is where per-file errors
# and helper stderr actually live.
set -u
trap '' PIPE

KEY_FILE="$HOME/.pixeldrain_api_key"
# Helper locations. Overridable so the test suite can point them at stubs.
: ${UI_BIN:="$HOME/.local/bin/pixeldrain-progress"}
: ${PICK_BIN:="$HOME/.local/bin/pixeldrain-picker"}
: ${PUT_BIN:="$HOME/.local/bin/pixeldrain-put"}
: ${LOG_FILE:="$HOME/Library/Logs/pixeldrain-upload.log"}

notify() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "PixelDrain"' \
    -e 'end run' -- "$1" >/dev/null 2>&1
}

# Blocking alert dialog, used as fallback when the progress window is unavailable.
alert() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display alert "PixelDrain" message (item 1 of argv) as critical buttons {"OK"} default button "OK"' \
    -e 'end run' -- "$1" >/dev/null 2>&1
}

# ---- run log ----
# The progress window can only show a summary, so per-file outcomes and helper
# stderr go here. Best-effort: a failure to log must never break an upload.
log() {
  print -r -- "$(/bin/date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG_FILE" 2>/dev/null
}

# Percent-encode each segment of a path, leaving the separators intact. Used for
# both the DELETE endpoint and the folder link put on the clipboard.
pd_encode_path() {
  /usr/bin/python3 -c \
    'import sys,urllib.parse; print("/".join(urllib.parse.quote(s) for s in sys.argv[1].split("/")))' \
    "$1" 2>/dev/null
}

# ---- retry policy (shared by the listing and upload paths) ----
RETRY_ATTEMPTS=3
RETRY_DELAY=2
UPLOAD_RETRY_DELAY=3

# A failure is worth retrying only if it might resolve itself: a network hiccup
# or a 5xx. Everything else — 4xx, "nokey", the helper's own permanent -1, or an
# empty result (helper missing/not executable) — will fail the same way forever.
is_transient() {
  case "$1" in
    network|5*) return 0 ;;
    *)          return 1 ;;
  esac
}

# The same question for the upload path, whose codes come from pixeldrain-put's
# RESULT line: 0 is a socket/network error, -1 is a permanent failure the helper
# diagnosed itself (missing file, no key), and an empty code means no RESULT
# arrived at all — the helper is missing, not executable, or was killed.
is_transient_upload() {
  case "$1" in
    0|5*) return 0 ;;
    *)    return 1 ;;
  esac
}

ui_active=0
ui() { (( ui_active )) && { print -r -- "$1" >&3 2>/dev/null || ui_active=0 } }
ui_open() {
  # The progress window is the only route to Pause and Cancel, so a missing
  # binary is fatal — silently degrading would leave an unstoppable upload
  # running with no feedback. Matches how a missing picker is handled.
  [[ -x "$UI_BIN" ]] || die "The progress window component is missing. Re-run install.sh."
  # Pass our PID (Cancel → SIGTERM us) and the pause-control file the
  # window's Pause button toggles.
  exec 3> >("$UI_BIN" $$ "$pausefile")
  ui_active=1
}
ui_done()      { ui "DONE $1";     (( ui_active )) && exec 3>&-; ui_active=0 }
ui_done_hold() { ui "DONEHOLD $1"; (( ui_active )) && exec 3>&-; ui_active=0 }
ui_quit()      { (( ui_active )) && exec 3>&-; ui_active=0 }

# ---- destination picker (native NSBrowser window; two-way via a coprocess) ----
# The picker is a pure view: we send it directory listings and it sends back the
# folder the user chose. print -p / read -p talk to the coprocess.
picker_active=0
picker_open() {
  if [[ -x "$PICK_BIN" ]]; then
    coproc "$PICK_BIN"
    picker_active=1
  fi
}
pk() { (( picker_active )) && print -rp -- "$1" 2>/dev/null }

# Route a status line to whichever window is currently up: the picker owns the
# setup phase, the progress window owns the upload phase.
status() {
  if (( picker_active )); then pk "STATUS $1"; else ui "STATUS $1"; fi
}

# Block while the UI has raised the pause flag. Checked at each file boundary.
pause_gate() {
  local announced=0
  while [[ "$(< "$pausefile")" == 1 ]]; do
    (( announced )) || { ui "STATUS Paused — click Resume to continue"; ui "PROGRESS ind"; announced=1 }
    /bin/sleep 0.3
  done
}

# Error path. While the picker is up, show the message inside it (a sheet) and
# wait for the user to dismiss it — the picker closes its end of the pipe, which
# we detect as EOF, so there is no second alert. Otherwise (progress-window phase
# or no UI yet) fall back to a blocking osascript alert, which keeps the workflow
# process alive until dismissed.
die() {
  if (( picker_active )); then
    pk "ERROR $1"
    while IFS= read -rp _ 2>/dev/null; do :; done   # drain until the picker exits
    picker_active=0
  else
    if (( ui_active )); then
      exec 3>&-
      ui_active=0
    fi
    alert "$1"
  fi
  [[ -n "${ctldir:-}" ]] && /bin/rm -rf "$ctldir"
  exit 1
}

# ---- Filesystem directory listing (via pixeldrain-put list) ----
# Populates LIST_DIRS / LIST_FILES (names) and LIST_FSIZE (name -> byte size);
# sets LIST_ERR to an HTTP code, "network", or "nokey" on failure, empty on
# success.
typeset -ga LIST_DIRS LIST_FILES
typeset -gA LIST_FSIZE
LIST_ERR=""
pd_list() {
  LIST_DIRS=(); LIST_FILES=(); LIST_FSIZE=(); LIST_ERR=""
  local line rest fsz fname
  while IFS= read -r line; do
    case "$line" in
      DIR\ *)       LIST_DIRS+=("${line#DIR }") ;;
      FILE\ *)      rest="${line#FILE }"; fsz="${rest%% *}"; fname="${rest#* }"
                    LIST_FILES+=("$fname"); LIST_FSIZE[$fname]="$fsz" ;;
      HTTPERROR\ *) LIST_ERR="${line#HTTPERROR }" ;;
    esac
  done < <(PD_AUTH_KEY="${API_KEY-}" "$PUT_BIN" list "$1" 2>>"$LOG_FILE")
}

# pd_list plus the shared transient-failure retry. Both callers — the picker's
# navigation and the pre-upload destination scan — need identical behavior, so
# neither should be re-implementing the loop. $2 labels the retry status line.
pd_list_retry() {
  local lpath="$1" doing="${2-}"
  local -i attempt=1
  pd_list "$lpath"
  while [[ -n "$LIST_ERR" ]] && is_transient "$LIST_ERR" && (( attempt < RETRY_ATTEMPTS )); do
    (( attempt++ ))
    [[ -n "$doing" ]] && status "Server error while $doing. Retrying ($attempt of $RETRY_ATTEMPTS)…"
    /bin/sleep "$RETRY_DELAY"
    pd_list "$lpath"
  done
}

# Test hook: sourcing with PD_LIB_ONLY=1 loads the helpers above without running
# an upload, so tests/run.sh can exercise them against stub helpers.
[[ "${PD_LIB_ONLY:-0}" == 1 ]] && return 0

if (( $# == 0 )); then
  print -u2 "Usage: pixeldrain-upload-fs <file-or-folder> [...]"
  exit 1
fi

# ---- control dir: upload FIFO + the pause flag the UI toggles ----
ctldir="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/pixeldrain-ctl.XXXXXX")"
pausefile="$ctldir/pause"
print -rn -- 0 > "$pausefile"

/bin/mkdir -p "${LOG_FILE:h}" 2>/dev/null

# Open the destination picker first; it shows a spinner + these status lines
# while we preflight, then swaps to the folder browser once listings arrive.
picker_open
pk "STATUS Reading API key…"

[[ -s "$KEY_FILE" ]] || die "No API key found. Save your key to ~/.pixeldrain_api_key and try again."
API_KEY="$(/usr/bin/tr -d '[:space:]' < "$KEY_FILE")"
# -s only proves the file is non-empty; a file holding just a newline strips to
# nothing and would otherwise fail later as a confusing "key rejected".
[[ -n "$API_KEY" ]] || die "No API key found. Save your key to ~/.pixeldrain_api_key and try again."
# The key gets interpolated into curl config text below, where a stray quote or
# backslash would silently corrupt the request rather than fail loudly. Keys are
# URL-safe, so anything else means the file holds something that isn't a key.
if [[ -n "${API_KEY//[A-Za-z0-9._~-]/}" ]]; then
  die "The API key in ~/.pixeldrain_api_key contains unexpected characters. Re-copy it from pixeldrain.com/user/api_keys."
fi
# A key other accounts on this Mac can read is worth flagging, but not fatal.
key_mode="$(/usr/bin/stat -f%Lp "$KEY_FILE" 2>/dev/null)"
if [[ -n "$key_mode" && "${key_mode[-2,-1]}" != 00 ]]; then
  log "WARN $KEY_FILE has mode $key_mode (group/world-readable)"
  pk "STATUS Warning: ~/.pixeldrain_api_key is readable by other users — chmod 600 it."
fi

# ---- cancellation state + handler ----
# Populated as work proceeds so the Cancel handler can tear everything down.
child_pid=""    # PID of the current killable child (pixeldrain-put)
cur_remote=""   # remote path of the upload in flight (for partial cleanup)

# DELETE a Filesystem path. Cookie is passed via a stdin curl config (print is a
# builtin), so the key never lands in argv.
pd_delete() {
  local enc
  enc="$(pd_encode_path "$1")" || return
  [[ -n "$enc" ]] || return
  print -r -- "header = \"Cookie: pd_auth_key=$API_KEY\"
request = \"DELETE\"
url = \"https://pixeldrain.com/api/filesystem/$enc\"" | \
    /usr/bin/curl -sS -m 15 -o /dev/null -K - 2>/dev/null
}

# Cancel: kill the in-flight child, delete any partial remote file, clean up.
cancel_handler() {
  trap '' TERM INT
  [[ -n "$child_pid" ]] && kill "$child_pid" 2>/dev/null
  [[ -n "$cur_remote" ]] && pd_delete "$cur_remote"
  [[ -n "$ctldir" ]] && /bin/rm -rf "$ctldir"
  ui_quit
  exit 0
}
trap cancel_handler TERM INT

# Preflight the Python dependency up front. On a Mac without Command Line Tools,
# /usr/bin/python3 pops a system install prompt; catching it here avoids that
# surprise mid-upload.
pk "STATUS Checking prerequisites…"
if ! /usr/bin/python3 --version >/dev/null 2>&1; then
  die "This action needs the macOS Command Line Tools (python3). Open Terminal, run:  xcode-select --install  and try again once it finishes."
fi

pk "STATUS Contacting pixeldrain.com…"
# Auth via a curl config read from stdin (print is a shell builtin, so the key
# never appears in any process's argument list).
api_check() {
  print -r -- "header = \"Cookie: pd_auth_key=$API_KEY\"
url = \"https://pixeldrain.com/api/user\"" | \
    /usr/bin/curl -sS -m 15 -o /dev/null -w "%{http_code}" -K - 2>/dev/null || print 000
}
attempt=1
while true; do
  api_code="$(api_check)"
  [[ "$api_code" == 200 || "$api_code" == 4* ]] && break
  (( attempt >= RETRY_ATTEMPTS )) && break
  (( attempt++ ))
  pk "STATUS PixelDrain not responding (HTTP $api_code). Retrying ($attempt of $RETRY_ATTEMPTS)…"
  /bin/sleep "$RETRY_DELAY"
done
case "$api_code" in
  200) ;;
  401|403) die "API key rejected (HTTP $api_code). Generate a new key at pixeldrain.com/user/api_keys." ;;
  000)     die "Unable to reach pixeldrain.com. Check your network connection." ;;
  5*)      die "PixelDrain server error (HTTP $api_code). The service is temporarily unavailable. Try again later." ;;
  *)       die "Unexpected API response (HTTP $api_code)." ;;
esac

# ---- navigation, driven by the native picker window ----
# The picker requests a folder's contents (LIST <path>); we stream them back as
# BEGIN/DIR/FILE/END. It sends CHOOSE <mode> <path> once the user confirms a
# destination (New Folder and Copy/Move are its own in-window sheets), or CANCEL.
(( picker_active )) || die "The destination picker component is missing. Re-run install.sh."

dest=""
mode=""
while (( picker_active )); do
  if ! IFS= read -rp cmdline 2>/dev/null; then
    # Picker closed its pipe without a decision → treat as cancel.
    picker_active=0
    /bin/rm -rf "$ctldir"
    exit 0
  fi
  verb="${cmdline%%[[:space:]]*}"
  case "$verb" in
    LIST)
      lpath="${cmdline#LIST }"
      pd_list_retry "$lpath" "listing folders"
      if [[ -n "$LIST_ERR" ]]; then
        log "ERROR listing $lpath: $LIST_ERR"
        case "$LIST_ERR" in
          401|402|403) die "Access to the PixelDrain Filesystem was denied (HTTP $LIST_ERR). This feature requires an active Pro subscription." ;;
          404)         die "Folder not found on PixelDrain (HTTP 404)." ;;
          5*)          die "PixelDrain server error while listing folders (HTTP $LIST_ERR). The service is temporarily unavailable. Try again later." ;;
          network)     die "Unable to reach pixeldrain.com while listing folders. Check your network connection." ;;
          nokey)       die "The API key could not be passed to the upload helper. Re-run install.sh." ;;
          *)           die "Unable to list the PixelDrain Filesystem (error: $LIST_ERR)." ;;
        esac
      fi
      pk "BEGIN $lpath"
      for name in "${LIST_DIRS[@]}";  do [[ -n "$name" ]] && pk "DIR $name";  done
      for name in "${LIST_FILES[@]}"; do [[ -n "$name" ]] && pk "FILE $name"; done
      pk "END $lpath"
      ;;
    CHOOSE)
      rest="${cmdline#CHOOSE }"
      mode="${rest%%[[:space:]]*}"   # copy | move
      dest="${rest#* }"              # remote path (may contain spaces)
      break
      ;;
    CANCEL)
      picker_active=0
      /bin/rm -rf "$ctldir"
      exit 0
      ;;
    *) : ;;   # ignore anything unexpected
  esac
done

# Destination chosen — dismiss the picker and hand off to the progress window.
pk "CLOSE"
picker_active=0

case "$mode" in
  copy|move) ;;
  *) /bin/rm -rf "$ctldir"; exit 0 ;;   # defensive: no valid mode → bail cleanly
esac

if [[ "$dest" == "me" ]]; then dest_label="/"; else dest_label="/${dest#me/}"; fi

# The picker owned the setup UI; now open the floating progress window for the
# upload itself (per-file status, overall %, Pause/Resume, Cancel).
ui_open

[[ "$mode" == move ]] && mode_title="Moving" || mode_title="Copying"
ui "TITLE $mode_title to ${dest_label}"
log "=== run start: mode=$mode dest=$dest items=$# ==="

# ---- build the upload plan (one entry per file) ----
ui "STATUS Scanning files…"
ui "PROGRESS ind"
typeset -a up_local up_remote up_size up_display plan_failed
typeset -i total_files=0 grand_bytes=0 any_folder=0
for item in "$@"; do
  item="${item%/}"                       # tolerate a trailing slash on folders
  if [[ -d "$item" ]]; then
    any_folder=1
    base="${item:t}"
    for f in "$item"/**/*(.DN); do
      rel="${f#$item/}"
      sz=$(/usr/bin/stat -f%z "$f" 2>/dev/null) || sz=0
      up_local+=("$f"); up_remote+=("$dest/$base/$rel"); up_display+=("$base/$rel"); up_size+=("$sz")
      (( grand_bytes += sz )); (( total_files++ ))
    done
  elif [[ -f "$item" ]]; then
    sz=$(/usr/bin/stat -f%z "$item" 2>/dev/null) || sz=0
    up_local+=("$item"); up_remote+=("$dest/${item:t}"); up_display+=("${item:t}"); up_size+=("$sz")
    (( grand_bytes += sz )); (( total_files++ ))
  else
    plan_failed+=("${item:t}: not found")
  fi
done

# ---- one listing per distinct destination folder -> remote_size map ----
# Local lookup replaces a per-file network stat: a file already present with the
# same size is skipped (no request), only files that need uploading hit network.
typeset -A remote_size seen_dirs
typeset -a dirs_to_list
for rp in "${up_remote[@]}"; do
  pdir="${rp:h}"
  [[ -z "${seen_dirs[$pdir]-}" ]] && { seen_dirs[$pdir]=1; dirs_to_list+=("$pdir") }
done
ui "STATUS Checking destination…"
for d in "${dirs_to_list[@]}"; do
  pd_list_retry "$d" "checking the destination"
  if [[ -n "$LIST_ERR" ]]; then
    # 404 is the expected case — the folder doesn't exist yet, so there is
    # nothing to skip against and make_parents will create it. Any other error
    # means the skip map is silently incomplete; uploading anyway would redo work
    # that is already on the server, so stop before touching anything.
    if [[ "$LIST_ERR" != 404 ]]; then
      log "ERROR scanning destination $d: $LIST_ERR"
      die "Unable to check the destination folder on PixelDrain (error: $LIST_ERR). Nothing has been uploaded — try again."
    fi
    continue
  fi
  for fname in "${LIST_FILES[@]}"; do
    remote_size[$d/$fname]="${LIST_FSIZE[$fname]}"
  done
done

# ---- upload loop (sequential; one file at a time) ----
typeset -a done_names failed skipped
(( ${#plan_failed} )) && failed+=("${plan_failed[@]}")
typeset -i bytes_done=0 moved_count=0
fifo="$ctldir/put.out"

for (( i = 1; i <= total_files; i++ )); do
  upfile="${up_local[i]}"
  remote="${up_remote[i]}"
  dsp="${up_display[i]}"
  fsize="${up_size[i]}"

  pause_gate

  base_pct=0
  (( grand_bytes > 0 )) && base_pct=$(( bytes_done * 100 / grand_bytes ))

  existing="${remote_size[$remote]-}"
  # Already present with the same size → skip (Move leaves it on disk).
  if [[ -n "$existing" && "$existing" == "$fsize" ]]; then
    skipped+=("$dsp")
    (( bytes_done += fsize ))
    continue
  fi
  # Pre-existing (different size) means overwrite: never delete it on cancel.
  target_exists=0
  [[ -n "$existing" ]] && target_exists=1

  attempt=1
  result=""
  while true; do
    ui "STATUS Uploading \"$dsp\" ($i of $total_files)…"
    (( grand_bytes > 0 )) && ui "PROGRESS $base_pct"

    /bin/rm -f "$fifo"; /usr/bin/mkfifo "$fifo"
    (( target_exists )) && cur_remote="" || cur_remote="$remote"
    # stderr goes to the run log, not /dev/null — it is often the only clue when
    # a file fails for a reason the RESULT line can't express.
    PD_AUTH_KEY="$API_KEY" "$PUT_BIN" fs "$upfile" "$remote" 2>>"$LOG_FILE" > "$fifo" &
    child_pid=$!

    result=""
    while IFS= read -r line; do
      case "$line" in
        PROGRESS\ *)
          pct="${line#PROGRESS }"
          # Byte-weighted overall progress across the whole selection.
          (( grand_bytes > 0 )) && ui "PROGRESS $(( (100 * bytes_done + fsize * pct) / grand_bytes ))"
          ui "STATUS Uploading \"$dsp\" ($i of $total_files): ${pct}%"
          ;;
        RESULT\ *) result="${line#RESULT }" ;;
      esac
    done < "$fifo"

    wait "$child_pid"
    child_pid=""
    cur_remote=""

    code="${result%% *}"
    # Success, a 4xx, the helper's permanent -1, or no RESULT line at all (the
    # helper is missing or not executable) — none of these improve on a retry.
    [[ "$code" == 2* ]] && break
    is_transient_upload "$code" || break
    (( attempt >= RETRY_ATTEMPTS )) && break
    (( attempt++ ))
    ui "STATUS Server error. Retrying \"$dsp\" ($attempt of $RETRY_ATTEMPTS)…"
    ui "PROGRESS ind"
    /bin/sleep "$UPLOAD_RETRY_DELAY"
  done

  body="${result#* }"
  if [[ "$code" == 2* ]]; then
    done_names+=("$dsp")
    remote_size[$remote]="$fsize"     # now present → a later identical file skips
    log "OK $code $remote"
    if [[ "$mode" == move ]]; then
      if /bin/rm -f "$upfile"; then
        (( moved_count++ ))
      else
        log "WARN uploaded but could not remove local file: $upfile"
      fi
    fi
  else
    msg="$(print -r -- "$body" | /usr/bin/sed -n 's/.*"message" *: *"\([^"]*\)".*/\1/p')"
    [[ -z "$msg" && ( "$code" == 0 || "$code" == -1 ) ]] && msg="$body"
    [[ -z "$msg" && -z "$code" ]] && msg="the upload helper produced no result (re-run install.sh)"
    failed+=("$dsp: ${msg:-HTTP error $code}")
    log "FAIL ${code:-none} $remote: ${msg:-HTTP error $code}"
  fi

  (( bytes_done += fsize ))
done

# Move: remove directories left empty (skipped files keep their dirs on disk).
if [[ "$mode" == move ]]; then
  for item in "$@"; do
    [[ -d "$item" ]] && /usr/bin/find "$item" -depth -type d -empty -delete 2>/dev/null
  done
fi

/bin/rm -rf "$ctldir"

typeset -i uploaded=${#done_names} nskip=${#skipped} nfail=${#failed}
log "=== run end: uploaded=$uploaded skipped=$nskip failed=$nfail ==="

if (( uploaded > 0 || nskip > 0 )); then
  # Percent-encoded: a destination containing a space or '#' otherwise yields a
  # link that silently truncates or 404s when pasted.
  dest_url="$(pd_encode_path "$dest")"
  print -r -- "https://pixeldrain.com/d/${dest_url:-$dest}" | /usr/bin/pbcopy
fi

# With more than one failure the window can only ever name one of them, so point
# at the log — every failure was written there as it happened.
fail_detail() {
  if (( nfail == 1 )); then
    print -r -- "${failed[1]}"
  else
    print -r -- "${failed[1]} — see $LOG_FILE for all $nfail"
  fi
}

# Big (folder / many files / >50 MB) → hold the result window open until the user
# clicks Close. A quick single small file still auto-closes.
big=0
(( any_folder || total_files > 1 || grand_bytes > 50 * 1024 * 1024 )) && big=1
finish() { if (( big )); then ui_done_hold "$1"; else ui_done "$1"; fi }

# Nothing uploaded at all, but there were hard failures → error alert.
if (( uploaded == 0 && nfail > 0 )); then
  die "Upload failed. $(fail_detail)"
fi

# Nothing uploaded and nothing failed → everything was already up to date / empty.
if (( uploaded == 0 )); then
  if (( nskip > 0 )); then
    finish "Nothing to upload — $nskip file(s) already up to date in ${dest_label}."
  else
    finish "No files were uploaded."
  fi
  exit 0
fi

dnoun="files"; (( uploaded == 1 )) && dnoun="file"
summary="Upload complete. $uploaded $dnoun uploaded to ${dest_label}."
(( nskip > 0 ))  && summary+=" $nskip already up to date."
[[ "$mode" == move ]] && summary+=" $moved_count removed from disk."
(( nfail > 0 ))  && summary+=" $nfail failed ($(fail_detail))."
summary+=" Folder link copied to clipboard."
finish "$summary"
notify "Uploaded $uploaded $dnoun to ${dest_label}."
