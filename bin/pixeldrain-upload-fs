#!/bin/zsh
# Upload files/folders into a chosen directory of the PixelDrain Filesystem
# (pixeldrain.com/d/me, a Pro feature). Finder-style navigation: each dialog
# shows one directory; double-click a folder to open it, "Go Up One Level" to
# go back, "New Folder Here…" to create one, "Upload to This Folder" to pick the
# current one.
#
# Folders are uploaded file-by-file, recreating the folder tree on PixelDrain
# (make_parents), so the progress window can show each file as it goes up and
# per-file skip/move can work. After picking a destination you choose Copy or
# Move; Move deletes each local file once it uploads. In both modes a file that
# already exists in the destination with the same name and size is skipped (in
# Move it is left on disk).
#
# Shows a floating progress window with live status, per-file names, overall
# byte-weighted percentage, a Pause/Resume button, and a Cancel button.
# API key is read from ~/.pixeldrain_api_key and passed to the helpers via the
# PD_AUTH_KEY environment variable (never on the command line, so it can't leak
# through `ps`).
set -u
trap '' PIPE

KEY_FILE="$HOME/.pixeldrain_api_key"
UI_BIN="$HOME/.local/bin/pixeldrain-progress"
PUT_BIN="$HOME/.local/bin/pixeldrain-put"

notify() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "PixelDrain"' \
    -e 'end run' -- "$1" >/dev/null 2>&1
}

# Blocking alert dialog, used as fallback when the progress window is unavailable.
alert() {
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display alert "PixelDrain" message (item 1 of argv) as critical buttons {"OK"} default button "OK"' \
    -e 'end run' -- "$1" >/dev/null 2>&1
}

ui_active=0
ui() { (( ui_active )) && { print -r -- "$1" >&3 2>/dev/null || ui_active=0 } }
ui_open() {
  if [[ -x "$UI_BIN" ]]; then
    # Pass our PID (Cancel → SIGTERM us) and the pause-control file the
    # window's Pause button toggles.
    exec 3> >("$UI_BIN" $$ "$pausefile")
    ui_active=1
  fi
}
ui_done()      { ui "DONE $1";     (( ui_active )) && exec 3>&-; ui_active=0 }
ui_done_hold() { ui "DONEHOLD $1"; (( ui_active )) && exec 3>&-; ui_active=0 }
ui_quit()      { (( ui_active )) && exec 3>&-; ui_active=0 }

# Block while the UI has raised the pause flag. Checked at each file boundary.
pause_gate() {
  local announced=0
  while [[ "$(< "$pausefile")" == 1 ]]; do
    (( announced )) || { ui "STATUS Paused — click Resume to continue"; ui "PROGRESS ind"; announced=1 }
    /bin/sleep 0.3
  done
}

# Error path: close the progress window, then show a blocking alert.
# The alert keeps the workflow process alive until dismissed; the window
# would be killed the moment the script exits.
die() {
  if (( ui_active )); then
    exec 3>&-
    ui_active=0
  fi
  [[ -n "${ctldir:-}" ]] && /bin/rm -rf "$ctldir"
  alert "$1"
  exit 1
}

if (( $# == 0 )); then
  print -u2 "Usage: pixeldrain-upload-fs <file-or-folder> [...]"
  exit 1
fi

total_items=$#
noun="items"; (( total_items == 1 )) && noun="item"

# ---- control dir: upload FIFO + the pause flag the UI toggles ----
ctldir="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/pixeldrain-ctl.XXXXXX")"
pausefile="$ctldir/pause"
print -rn -- 0 > "$pausefile"

ui_open
ui "TITLE Uploading $total_items $noun to the PixelDrain Filesystem"
ui "STATUS Reading API key…"

[[ -s "$KEY_FILE" ]] || die "No API key found. Save your key to ~/.pixeldrain_api_key and try again."
API_KEY="$(/usr/bin/tr -d '[:space:]' < "$KEY_FILE")"
export PD_AUTH_KEY="$API_KEY"

# ---- cancellation state + handler ----
# Populated as work proceeds so the Cancel handler can tear everything down.
child_pid=""    # PID of the current killable child (pixeldrain-put)
cur_remote=""   # remote path of the upload in flight (for partial cleanup)

# DELETE a Filesystem path. Cookie is passed via a stdin curl config (print is a
# builtin), so the key never lands in argv.
pd_delete() {
  local enc
  enc="$(/usr/bin/python3 -c 'import sys,urllib.parse; print("/".join(urllib.parse.quote(s) for s in sys.argv[1].split("/")))' "$1" 2>/dev/null)" || return
  print -r -- "header = \"Cookie: pd_auth_key=$API_KEY\"
request = \"DELETE\"
url = \"https://pixeldrain.com/api/filesystem/$enc\"" | \
    /usr/bin/curl -sS -m 15 -o /dev/null -K - 2>/dev/null
}

# Cancel: kill the in-flight child, delete any partial remote file, clean up.
cancel_handler() {
  trap '' TERM INT
  [[ -n "$child_pid" ]] && kill "$child_pid" 2>/dev/null
  [[ -n "$cur_remote" ]] && pd_delete "$cur_remote"
  [[ -n "$ctldir" ]] && /bin/rm -rf "$ctldir"
  ui_quit
  exit 0
}
trap cancel_handler TERM INT

# Preflight the Python dependency up front. On a Mac without Command Line Tools,
# /usr/bin/python3 pops a system install prompt; catching it here avoids that
# surprise mid-upload.
ui "STATUS Checking prerequisites…"
if ! /usr/bin/python3 --version >/dev/null 2>&1; then
  die "This action needs the macOS Command Line Tools (python3). Open Terminal, run:  xcode-select --install  and try again once it finishes."
fi

ui "STATUS Contacting pixeldrain.com…"
# Auth via a curl config read from stdin (print is a shell builtin, so the key
# never appears in any process's argument list).
api_check() {
  print -r -- "header = \"Cookie: pd_auth_key=$API_KEY\"
url = \"https://pixeldrain.com/api/user\"" | \
    /usr/bin/curl -sS -m 15 -o /dev/null -w "%{http_code}" -K - 2>/dev/null || print 000
}
attempt=1
while true; do
  api_code="$(api_check)"
  [[ "$api_code" == 200 || "$api_code" == 4* ]] && break
  (( attempt >= 3 )) && break
  (( attempt++ ))
  ui "STATUS PixelDrain not responding (HTTP $api_code). Retrying ($attempt of 3)…"
  /bin/sleep 2
done
case "$api_code" in
  200) ;;
  401|403) die "API key rejected (HTTP $api_code). Generate a new key at pixeldrain.com/user/api_keys." ;;
  000)     die "Unable to reach pixeldrain.com. Check your network connection." ;;
  5*)      die "PixelDrain server error (HTTP $api_code). The service is temporarily unavailable. Try again later." ;;
  *)       die "Unexpected API response (HTTP $api_code)." ;;
esac

# ---- Filesystem directory listing (via pixeldrain-put list) ----
# Populates LIST_DIRS / LIST_FILES (names) and LIST_FSIZE (name -> byte size);
# sets LIST_ERR to an HTTP code or "network" on failure, empty on success.
typeset -ga LIST_DIRS LIST_FILES
typeset -gA LIST_FSIZE
LIST_ERR=""
pd_list() {
  LIST_DIRS=(); LIST_FILES=(); LIST_FSIZE=(); LIST_ERR=""
  local line rest fsz fname
  while IFS= read -r line; do
    case "$line" in
      DIR\ *)       LIST_DIRS+=("${line#DIR }") ;;
      FILE\ *)      rest="${line#FILE }"; fsz="${rest%% *}"; fname="${rest#* }"
                    LIST_FILES+=("$fname"); LIST_FSIZE[$fname]="$fsz" ;;
      HTTPERROR\ *) LIST_ERR="${line#HTTPERROR }" ;;
    esac
  done < <("$PUT_BIN" list "$1")
}

# Ask for a new folder name; prints the trimmed name, or empty if cancelled/blank.
prompt_new_folder() {
  local name
  name="$(/usr/bin/osascript \
    -e 'tell application "System Events" to activate' \
    -e 'set r to display dialog "New folder name:" default answer "" with title "PixelDrain" buttons {"Cancel", "Create"} default button "Create"' \
    -e 'text returned of r' 2>/dev/null)" || { print -r -- ""; return }
  name="${name//\//}"                          # slashes would break the path
  name="${name#"${name%%[![:space:]]*}"}"      # strip leading whitespace
  name="${name%"${name##*[![:space:]]}"}"      # strip trailing whitespace
  print -r -- "$name"
}

UPLOAD_HERE="Upload to This Folder"
NEW_FOLDER="＋ New Folder Here…"
GO_UP="Go Up One Level"

# ---- Finder-style navigation loop ----
current="me"
dest=""
while true; do
  ui "STATUS Loading folder list…"
  ui "PROGRESS ind"
  pd_list "$current"
  attempt=1
  # Retry only transient failures (network / 5xx); 4xx won't fix on retry.
  while [[ -n "$LIST_ERR" ]] && (( attempt < 3 )); do
    case "$LIST_ERR" in network|5*) ;; *) break ;; esac
    (( attempt++ ))
    ui "STATUS Server error while listing folders. Retrying ($attempt of 3)…"
    /bin/sleep 2
    pd_list "$current"
  done
  if [[ -n "$LIST_ERR" ]]; then
    case "$LIST_ERR" in
      401|402|403) die "Access to the PixelDrain Filesystem was denied (HTTP $LIST_ERR). This feature requires an active Pro subscription." ;;
      404)         die "Folder not found on PixelDrain (HTTP 404)." ;;
      5*)          die "PixelDrain server error while listing folders (HTTP $LIST_ERR). The service is temporarily unavailable. Try again later." ;;
      network)     die "Unable to reach pixeldrain.com while listing folders. Check your network connection." ;;
      *)           die "Unable to list the PixelDrain Filesystem (error: $LIST_ERR)." ;;
    esac
  fi

  typeset -a entries
  entries=("$UPLOAD_HERE" "$NEW_FOLDER")
  [[ "$current" != "me" ]] && entries+=("$GO_UP")
  # Subfolders carry a trailing slash so they are distinguishable from the
  # action rows above and from files.
  for name in "${LIST_DIRS[@]}"; do
    [[ -z "$name" ]] && continue
    entries+=("$name/")
  done

  if [[ "$current" == "me" ]]; then disp="/"; else disp="/${current#me/}"; fi
  ui "STATUS Waiting for destination selection (${disp})…"

  # Note: "OK button name" takes no "with" keyword. Adding one is a syntax
  # error, which makes osascript exit non-zero with no output.
  choice="$(/usr/bin/osascript \
    -e 'on run argv' \
    -e 'set thePrompt to item 1 of argv' \
    -e 'set L to rest of argv' \
    -e 'tell application "System Events" to activate' \
    -e 'set r to choose from list L with title "PixelDrain" with prompt thePrompt default items {item 1 of L} OK button name "Choose" cancel button name "Cancel"' \
    -e 'if r is false then return "CANCELLED"' \
    -e 'return item 1 of r' \
    -e 'end run' -- "Current folder: ${disp}
Double-click a folder to open it." "${entries[@]}")" \
    || die "Unable to display the destination picker. AppleScript reported an error."

  case "$choice" in
    CANCELLED)      ui_quit; /bin/rm -rf "$ctldir"; exit 0 ;;
    "")             die "The destination picker returned no selection." ;;
    "$UPLOAD_HERE") dest="$current"; break ;;
    "$NEW_FOLDER")
      newname="$(prompt_new_folder)"
      [[ -z "$newname" ]] && continue   # cancelled or blank → back to the list
      dest="$current/$newname"; break ;;
    "$GO_UP")       current="${current:h}" ;;
    */)             current="$current/${choice%/}" ;;
    *)              die "Unrecognised selection: $choice" ;;
  esac
done

if [[ "$dest" == "me" ]]; then dest_label="/"; else dest_label="/${dest#me/}"; fi

# ---- Copy or Move? ----
mode="$(/usr/bin/osascript \
  -e 'on run argv' \
  -e 'tell application "System Events" to activate' \
  -e 'set dlg to "Upload into " & (item 1 of argv) & "?" & return & return & "Copy keeps the originals. Move deletes each local file after it uploads. In both modes, files already in the destination with the same name and size are skipped (Move leaves those on disk)."' \
  -e 'set r to display dialog dlg with title "PixelDrain" buttons {"Cancel", "Move", "Copy"} default button "Copy"' \
  -e 'button returned of r' \
  -e 'end run' -- "$dest_label" 2>/dev/null)" || { ui_quit; /bin/rm -rf "$ctldir"; exit 0; }
case "$mode" in
  Copy) mode=copy ;;
  Move) mode=move ;;
  *)    ui_quit; /bin/rm -rf "$ctldir"; exit 0 ;;
esac

[[ "$mode" == move ]] && mode_title="Moving" || mode_title="Copying"
ui "TITLE $mode_title to ${dest_label}"

# ---- build the upload plan (one entry per file) ----
ui "STATUS Scanning files…"
ui "PROGRESS ind"
typeset -a up_local up_remote up_size up_display plan_failed
typeset -i total_files=0 grand_bytes=0 any_folder=0
for item in "$@"; do
  item="${item%/}"                       # tolerate a trailing slash on folders
  if [[ -d "$item" ]]; then
    any_folder=1
    base="${item:t}"
    for f in "$item"/**/*(.DN); do
      rel="${f#$item/}"
      sz=$(/usr/bin/stat -f%z "$f" 2>/dev/null) || sz=0
      up_local+=("$f"); up_remote+=("$dest/$base/$rel"); up_display+=("$base/$rel"); up_size+=("$sz")
      (( grand_bytes += sz )); (( total_files++ ))
    done
  elif [[ -f "$item" ]]; then
    sz=$(/usr/bin/stat -f%z "$item" 2>/dev/null) || sz=0
    up_local+=("$item"); up_remote+=("$dest/${item:t}"); up_display+=("${item:t}"); up_size+=("$sz")
    (( grand_bytes += sz )); (( total_files++ ))
  else
    plan_failed+=("${item:t}: not found")
  fi
done

# ---- one listing per distinct destination folder -> remote_size map ----
# Local lookup replaces a per-file network stat: a file already present with the
# same size is skipped (no request), only files that need uploading hit network.
typeset -A remote_size seen_dirs
typeset -a dirs_to_list
for rp in "${up_remote[@]}"; do
  pdir="${rp:h}"
  [[ -z "${seen_dirs[$pdir]-}" ]] && { seen_dirs[$pdir]=1; dirs_to_list+=("$pdir") }
done
ui "STATUS Checking destination…"
for d in "${dirs_to_list[@]}"; do
  pd_list "$d"
  [[ -n "$LIST_ERR" ]] && continue   # 404/absent → nothing here to skip against
  for fname in "${LIST_FILES[@]}"; do
    remote_size[$d/$fname]="${LIST_FSIZE[$fname]}"
  done
done

# ---- upload loop (sequential; one file at a time) ----
typeset -a done_names failed skipped
(( ${#plan_failed} )) && failed+=("${plan_failed[@]}")
typeset -i bytes_done=0 moved_count=0
fifo="$ctldir/put.out"

for (( i = 1; i <= total_files; i++ )); do
  upfile="${up_local[i]}"
  remote="${up_remote[i]}"
  dsp="${up_display[i]}"
  fsize="${up_size[i]}"

  pause_gate

  base_pct=0
  (( grand_bytes > 0 )) && base_pct=$(( bytes_done * 100 / grand_bytes ))

  existing="${remote_size[$remote]-}"
  # Already present with the same size → skip (Move leaves it on disk).
  if [[ -n "$existing" && "$existing" == "$fsize" ]]; then
    skipped+=("$dsp")
    (( bytes_done += fsize ))
    continue
  fi
  # Pre-existing (different size) means overwrite: never delete it on cancel.
  target_exists=0
  [[ -n "$existing" ]] && target_exists=1

  attempt=1
  result=""
  while true; do
    ui "STATUS Uploading \"$dsp\" ($i of $total_files)…"
    (( grand_bytes > 0 )) && ui "PROGRESS $base_pct"

    /bin/rm -f "$fifo"; /usr/bin/mkfifo "$fifo"
    (( target_exists )) && cur_remote="" || cur_remote="$remote"
    "$PUT_BIN" fs "$upfile" "$remote" 2>/dev/null > "$fifo" &
    child_pid=$!

    result=""
    while IFS= read -r line; do
      case "$line" in
        PROGRESS\ *)
          pct="${line#PROGRESS }"
          # Byte-weighted overall progress across the whole selection.
          (( grand_bytes > 0 )) && ui "PROGRESS $(( (100 * bytes_done + fsize * pct) / grand_bytes ))"
          ui "STATUS Uploading \"$dsp\" ($i of $total_files): ${pct}%"
          ;;
        RESULT\ *) result="${line#RESULT }" ;;
      esac
    done < "$fifo"

    wait "$child_pid"
    child_pid=""
    cur_remote=""

    code="${result%% *}"
    [[ "$code" == 2* || "$code" == 4* ]] && break
    (( attempt >= 3 )) && break
    (( attempt++ ))
    ui "STATUS Server error. Retrying \"$dsp\" ($attempt of 3)…"
    ui "PROGRESS ind"
    /bin/sleep 3
  done

  body="${result#* }"
  if [[ "$code" == 2* ]]; then
    done_names+=("$dsp")
    remote_size[$remote]="$fsize"     # now present → a later identical file skips
    if [[ "$mode" == move ]]; then
      /bin/rm -f "$upfile" && (( moved_count++ ))
    fi
  else
    msg="$(print -r -- "$body" | /usr/bin/sed -n 's/.*"message" *: *"\([^"]*\)".*/\1/p')"
    [[ -z "$msg" && "$code" == 0 ]] && msg="$body"
    failed+=("$dsp: ${msg:-HTTP error $code}")
  fi

  (( bytes_done += fsize ))
done

# Move: remove directories left empty (skipped files keep their dirs on disk).
if [[ "$mode" == move ]]; then
  for item in "$@"; do
    [[ -d "$item" ]] && /usr/bin/find "$item" -depth -type d -empty -delete 2>/dev/null
  done
fi

/bin/rm -rf "$ctldir"

typeset -i uploaded=${#done_names} nskip=${#skipped} nfail=${#failed}

if (( uploaded > 0 || nskip > 0 )); then
  print -r -- "https://pixeldrain.com/d/$dest" | /usr/bin/pbcopy
fi

# Big (folder / many files / >50 MB) → hold the result window open until the user
# clicks Close. A quick single small file still auto-closes.
big=0
(( any_folder || total_files > 1 || grand_bytes > 50 * 1024 * 1024 )) && big=1
finish() { if (( big )); then ui_done_hold "$1"; else ui_done "$1"; fi }

# Nothing uploaded at all, but there were hard failures → error alert.
if (( uploaded == 0 && nfail > 0 )); then
  die "Upload failed. ${failed[1]}"
fi

# Nothing uploaded and nothing failed → everything was already up to date / empty.
if (( uploaded == 0 )); then
  if (( nskip > 0 )); then
    finish "Nothing to upload — $nskip file(s) already up to date in ${dest_label}."
  else
    finish "No files were uploaded."
  fi
  exit 0
fi

dnoun="files"; (( uploaded == 1 )) && dnoun="file"
summary="Upload complete. $uploaded $dnoun uploaded to ${dest_label}."
(( nskip > 0 ))  && summary+=" $nskip already up to date."
[[ "$mode" == move ]] && summary+=" $moved_count removed from disk."
(( nfail > 0 ))  && summary+=" $nfail failed (${failed[1]})."
summary+=" Folder link copied to clipboard."
finish "$summary"
notify "Uploaded $uploaded $dnoun to ${dest_label}."
